# Supabase (Carely 전용 신규 프로젝트)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# service-role 키는 서버 전용(크론 등 시스템 작업). 절대 클라이언트에 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Web Push (VAPID) — `node scripts/vapid-keys.mjs` 로 1회 생성 (vapid-keys.txt 로 떨어진다)
#   공개 키 87자, B 로 시작 / 개인 키 43자. 바꿔 넣는 실수가 가장 흔하다.
#   NEXT_PUBLIC_ 은 빌드 시점에 번들에 박히므로 바꾼 뒤 재배포해야 한다.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@carely.app

# 15분 크론 엔드포인트 보호용 Bearer 토큰 (Vercel cron 이 Authorization 헤더로 전송)
CRON_SECRET=

# (선택) 푸시 실패 시 이메일 폴백
RESEND_API_KEY=
